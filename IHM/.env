# Mettre à false pour utiliser la vraie carte USB
SIMULATION=false

# Ports selon l'usage
SERIAL_PORT_SIM=/tmp/ttyV1
# Repli si l'auto-détection par numéro de série échoue
SERIAL_PORT_REAL=/dev/ttyUSB0

# Numéro de série CP2104 du transceiver (auto-détection du port en mode réel).
# Le retrouver avec : udevadm info -q property -n /dev/ttyUSBx | grep SERIAL_SHORT
TRANSCEIVER_SERIAL=01C00B54

# Paramètres communs
BAUD_RATE=115200
MONGO_URI=mongodb://localhost:27017
DB_NAME=autoboat
SERVER_PORT=5000
